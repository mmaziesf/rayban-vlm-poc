# One image for build, test runner and emulator. Mirrors the bot box toolchain (tools/env.sh).
#   docker build -f infra/k8s/Dockerfile.android -t REGISTRY/glance-android:0.1 .
FROM debian:trixie-slim
ARG CMDLINE_TOOLS=13114758
ARG KOTLIN=2.4.21
ARG SYSIMG="system-images;android-29;default;x86_64"
ENV ANDROID_HOME=/opt/android-sdk JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:$PATH \
    GRADLE_OPTS="-Dorg.gradle.daemon=false"
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip curl ca-certificates \
      socat procps libpulse0 libnss3 libxcomposite1 libxcursor1 libxi6 libxtst6 libgl1 libx11-xcb1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p $ANDROID_HOME/cmdline-tools && cd /tmp \
 && curl -fsSLo t.zip https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS}_latest.zip \
 && unzip -q t.zip && mv cmdline-tools $ANDROID_HOME/cmdline-tools/latest && rm t.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "emulator" "$SYSIMG" >/dev/null \
 && echo no | avdmanager create avd -n glance -k "$SYSIMG" -d pixel \
 && sed -i 's/^hw.ramSize=.*/hw.ramSize=1536/' /root/.android/avd/glance.avd/config.ini
RUN cd /opt && curl -fsSLo k.zip https://github.com/JetBrains/kotlin/releases/download/v${KOTLIN}/kotlin-compiler-${KOTLIN}.zip \
 && unzip -q k.zip && rm k.zip && ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc   # for phone/core/run-tests.sh
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY infra/k8s/emulator-entry.sh /usr/local/bin/emulator-entry.sh
WORKDIR /src
