<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- UNVERIFIED. Keys per DAT iOS README/.cursor rules (1.0.1). MetaAppID/ClientToken/TeamID: user-provided at D1-iOS. -->
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>Glance</string>
  <key>CFBundleDisplayName</key><string>Glance</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>UILaunchScreen</key><dict/>
  <key>CFBundleURLTypes</key><array><dict><key>CFBundleTypeRole</key><string>Editor</string><key>CFBundleURLName</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string><key>CFBundleURLSchemes</key><array><string>glance</string><string>glance-debug</string></array></dict></array>
  <!-- Privacy strings: iOS terminates the app (TCC) if camera/mic/speech are touched without them.
       Suspected cause of CI run 38107229753 crash on "Start (mock)" (camera stream + speech). Meta's CameraAccess sample declares mic+camera. -->
  <key>NSMicrophoneUsageDescription</key><string>Hear voice commands for Glance.</string>
  <key>NSCameraUsageDescription</key><string>See what you are looking at.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Understand voice commands.</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>Connect to your Meta glasses.</string>
  <key>UIBackgroundModes</key><array><string>processing</string><string>bluetooth-central</string><string>bluetooth-peripheral</string><string>external-accessory</string></array>
  <key>NSLocalNetworkUsageDescription</key><string>Find and connect to your glasses over Wi-Fi.</string>
  <key>NSBonjourServices</key><array><string>_bonjour._tcp</string></array>
  <key>UISupportedExternalAccessoryProtocols</key><array><string>com.meta.ar.wearable</string></array>
  <key>MWDAT</key><dict>
    <key>AppLinkURLScheme</key><string>glance://</string>
    <key>MetaAppID</key><string>$(META_APP_ID)</string>
    <key>ClientToken</key><string>$(CLIENT_TOKEN)</string>
    <key>TeamID</key><string>$(DEVELOPMENT_TEAM)</string>
    <key>Analytics</key><dict><key>OptOut</key><true/></dict>
    <key>CrashReporting</key><dict><key>OptOut</key><true/></dict>
  </dict>
</dict></plist>
